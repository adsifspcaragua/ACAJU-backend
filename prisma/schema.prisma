model Document {
  id          String   @id @default(uuid())
  name        String 
  description String   @db.Text
  fileUrl     String // URL do PDF upado
  createdAt   DateTime @default(now())

  adminId String
  ADM     ADM    @relation(fields: [adminId], references: [id])
}

// 6. GALERIA GLOBAL (Tela Galeria de Fotos)

model GalleryImage {
  id            String   @id @default(uuid())
  imageUrl      String
  createdAt     DateTime @default(now())
  galleryImages Json?
}
